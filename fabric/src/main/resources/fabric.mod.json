{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {
    "homepage": "",
    "sources": ""
  },
  "license": "${mod_license}",
  "icon": "${mod_icon}",
  "environment": "*",
  "entrypoints": {
    "main": ["grill24.workingwolves.fabric.WorkingWolvesFabric"],
    "client": ["grill24.workingwolves.fabric.WorkingWolvesFabricClient"],
    "fabric-datagen": ["grill24.workingwolves.fabric.datagen.WorkingWolvesDataGenerator"]
