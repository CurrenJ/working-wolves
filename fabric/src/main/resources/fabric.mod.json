  "mixins": ["workingwolves.mixins.json", "workingwolves-fabric.mixins.json"],
  "accessWidener": "workingwolves.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.1",
    "minecraft": "${mod_fabric_minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
